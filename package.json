{
  "name": "lazy-ease-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "e2e": "pnpm --filter e2e e2e",
    "check:packages": "node scripts/check-packages.mjs",
    "check:next": "node scripts/next-smoke.mjs",
    "check:fixtures": "python3 scripts/check-fixtures.py"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@lazy-ease/testing": "workspace:*",
    "@types/node": "^26.6.6",
    "publint": "0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
