{
  "name": "lazy-ease",
  "version": "0.0.0",
  "description": "Lazy-loaded, optimized React images with a placeholder crossfade",
  "license": "MIT",
  "author": "Mike Kuss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikekuss/lazy-ease.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "image",
    "lazy-loading",
    "srcset",
    "placeholder",
    "webp",
    "avif"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "thumbhash": "0.1.1"
  }
}
