{
  "name": "@lazy-ease/react",
  "version": "0.2.0",
  "description": "Lazy-loaded, right-sized React images with an inline placeholder and a crossfade",
  "license": "MIT",
  "author": "Mike Kuss",
  "homepage": "https://mikekuss.github.io/lazy-ease/",
  "bugs": {
    "url": "https://github.com/mikekuss/lazy-ease/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikekuss/lazy-ease.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "image",
    "lazy-loading",
    "responsive-images",
    "srcset",
    "placeholder",
    "thumbhash",
    "webp",
    "avif",
    "ssr"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@lazy-ease/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "thumbhash": "0.1.1"
  }
}
