{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    // Build against the built declarations of core, not its sources.
    "customConditions": []
  },
  "include": ["src"],
  // The self-starting scripts are bundled by scripts/bundle.mjs, not compiled on their own.
  "exclude": ["src/auto.ts", "src/auto-prepared.ts", "src/boot.ts"]
}
