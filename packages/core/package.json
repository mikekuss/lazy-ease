{
  "name": "@lazy-ease/core",
  "version": "0.2.0",
  "description": "Framework-free lazy-ease logic: ladders, canonical URLs, crop geometry, loaders and the DOM image controller",
  "license": "MIT",
  "author": "Mike Kuss",
  "homepage": "https://mikekuss.github.io/lazy-ease/",
  "bugs": {
    "url": "https://github.com/mikekuss/lazy-ease/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikekuss/lazy-ease.git",
    "directory": "packages/core"
  },
  "keywords": [
    "lazy-ease",
    "image",
    "responsive-images",
    "srcset",
    "loader",
    "crop"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./thumbhash": {
      "source": "./src/thumbhash.ts",
      "types": "./dist/thumbhash.d.ts",
      "default": "./dist/thumbhash.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./thumbhash": {
        "types": "./dist/thumbhash.d.ts",
        "default": "./dist/thumbhash.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.pure.json"
  }
}
