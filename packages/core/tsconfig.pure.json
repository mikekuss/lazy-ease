{
  // The modules outside src/dom must run without a DOM: this checks them
  // against plain ES2023. A DOM import from one of them fails here too.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": [],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/dom", "src/index.ts"]
}
