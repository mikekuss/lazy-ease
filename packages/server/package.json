{
  "name": "@lazy-ease/server",
  "version": "0.2.0",
  "description": "Image resize and optimization server for lazy-ease (Hono + sharp), with metadata tooling",
  "license": "MIT",
  "author": "Mike Kuss",
  "homepage": "https://mikekuss.github.io/lazy-ease/",
  "bugs": {
    "url": "https://github.com/mikekuss/lazy-ease/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikekuss/lazy-ease.git",
    "directory": "packages/server"
  },
  "keywords": [
    "lazy-ease",
    "image",
    "resize",
    "sharp",
    "hono",
    "thumbhash",
    "webp",
    "avif",
    "cdn"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "sharp": "^0.35.5",
    "thumbhash": "0.1.1"
  }
}
