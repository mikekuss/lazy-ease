{
  "name": "demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch --conditions=source server.ts\" \"vite\"",
    "build:static": "vite build --mode static && tsx --conditions=source scripts/build-static.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@lazy-ease/server": "workspace:*",
    "hono": "^4.13.16",
    "@lazy-ease/react": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "vite": "^8.3.5"
  }
}
